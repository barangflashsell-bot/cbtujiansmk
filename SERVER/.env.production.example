APP_NAME="CBT Local Server"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.100:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Konkurensi Worker PHP CLI Server untuk melayani 100+ koneksi simultan Android
PHP_CLI_SERVER_WORKERS=16

BCRYPT_ROUNDS=10

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbt_v1_prod
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=cbt_cache_

# Rate Limiting & Keamanan
CORS_ALLOWED_ORIGINS="*"
